# Copy to .env and fill in. NEVER commit the real .env file.
POSTGRES_DB=billing
POSTGRES_USER=postgres
POSTGRES_PASSWORD=2504

# At least 32 random characters. Generate one:  openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRY_MINUTES=480

# First admin account, created only when the user table is empty
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=admin@1234

# Comma-separated browser origins allowed to call the API directly (not needed when using the nginx proxy)
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
